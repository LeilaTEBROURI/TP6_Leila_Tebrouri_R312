---
import Layout from "../../../layouts/Layout.astro";
import cars from "../../../assets/cars.json";

const cylinders = [...new Set(cars.map((car) => car.cylinders))].sort((a, b) => a - b);
---

<Layout>
  <main id="contenu">
    <p class="eyebrow">03 · Rendu statique</p>
    <h1>Voitures — rendu statique</h1>
    <ul>
      {cylinders.map((name) => (
        <li><a class="page-link" href={`/cars/rendu-statique/${name}`}>{name} cylindres</a></li>
      ))}
    </ul>
    <p class="mt-6"><a class="page-link" href="/cars/">Retour au slider</a></p>
  </main>
</Layout>

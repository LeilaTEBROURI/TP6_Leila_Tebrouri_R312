---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

// Récupère les espèces, sans doublons, à partir des données.
const species = [...new Set(penguins.map((penguin) => penguin.species))];
---

<Layout>
  <main id="contenu">
    <p class="eyebrow">01 · Toutes les espèces</p>
    <h1>Les penguins par espèce</h1>
    <nav aria-label="Choisir une espèce">
      {species.map((name) => <a href={`#${name}`}>{name}</a>)}
    </nav>

    <div class="slider" tabindex="0" role="region" aria-label="Graphiques des espèces">
      {species.map((name) => (
        <section id={name} aria-label={`Graphique ${name}`}>
          <h2>{name}</h2>
          <PlotFigure options={{
            color: { domain: species, range: ["#67e0bd", "#8da9ff", "#ffca58"] },
            marks: [
              Plot.dot(penguins.filter((penguin) => penguin.species === name), {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
              }),
            ],
          }} />
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .slider { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
  section { flex: 0 0 100%; min-width: 0; scroll-snap-align: start; padding: 24px; border: 1px solid #29404b; border-radius: 16px; background: #0a2534; }
  nav { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
  nav a { padding: 10px 18px; border: 1px solid #67e0bd; border-radius: 10px; }
</style>

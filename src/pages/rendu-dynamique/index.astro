---
import Layout from "../../layouts/Layout.astro";
import penguins from "../../assets/penguins.json";

const species = [...new Set(penguins.map((penguin) => penguin.species))];
---

<Layout>
  <main id="contenu">
    <p class="eyebrow">02 · Rendu dynamique</p>
    <h1>Penguins — rendu dynamique</h1>
    <ul>
      {species.map((name) => (
        <li><a class="page-link" href={`/rendu-dynamique/${name}`}>{name}</a></li>
      ))}
    </ul>
    <p class="mt-6"><a class="page-link" href="/">Retour au slider</a></p>
  </main>
</Layout>
